# Connection defaults for the parroquia editor — fixed deployment config,
# never user-editable (they were removed from the login UI).
#
# These are optional build-time overrides. If unset, the editor uses the
# hardcoded defaults in docs/.vitepress/theme/lib/store.js (DEFAULTS).
# Export them when running the build, or copy this file to `.env`.
#
#   VITE_PE_API_BASE=... npm run build
#
VITE_PE_API_BASE=https://api.parroquia.app
VITE_PE_DATA_BASE=https://data.parroquia.app
VITE_PE_SCHEMA_URL=_pages.yml

# Búsqueda de imágenes de Unsplash en el selector. La access key *pública* va
# integrada en docs/.vitepress/theme/lib/unsplash.js (flujo client_id, pensado
# para el navegador); esta variable solo existe como sobrescritura en build
# time y no hace falta definirla.
VITE_UNSPLASH_ACCESS_KEY=

# Búsqueda de imágenes de Pexels en el selector. La clave va integrada en
# docs/.vitepress/theme/lib/pexels.js (cabecera Authorization, pensada para el
# navegador); esta variable solo existe como sobrescritura en build time y no
# hace falta definirla.
VITE_PEXELS_API_KEY=
